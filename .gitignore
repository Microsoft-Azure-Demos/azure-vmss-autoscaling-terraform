# Terraform working directories and downloaded providers
**/.terraform/

# Terraform state files (may contain sensitive information)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plans
*.tfplan
tfplan
plan.out

# Terraform crash logs
crash.log
crash.*.log

# Variable files (may contain sensitive values)
#*.tfvars
#*.tfvars.json
#!*.tfvars.example

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Private keys and certificates
*.pem
*.key

# Keep .terraform.lock.hcl tracked for reproducible provider versions
